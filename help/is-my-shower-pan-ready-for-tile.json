  "mainEntity": {
    "name": "Is My Shower Pan Ready for Tile?",
    "text": "Is My Shower Pan Ready for Tile?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "You're eager to get those beautiful new tiles down in your shower, but is the pan truly ready? This is a critical question, as a faulty shower pan can lead to major headaches down the road. The most important thing to know is that a shower pan needs to be flood tested for a full 24 hours *before* any mortar bed or shower floor tile is installed. This isn't a step you can skip; it's the only way to confirm that your pan is properly sloped and watertight. HH Remodeling LLC always performs this essential test because catching leaks at this stage saves immense time and money compared to discovering them after the tile is laid. You also need to ensure the base is structurally sound and free from any movement. If you're unsure about your shower pan's readiness or the integrity of your shower's base, it's a strong signal to consult with a professional. They can assess the situation and ensure everything is set up for a successful, leak-free installation.",
      "@type": "Answer",
      "author": {
        "name": "HH Remodeling LLC",
        "@type": "Organization"
      }
    }
  }
