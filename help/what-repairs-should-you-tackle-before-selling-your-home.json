  "headline": "What Repairs Should You Tackle Before Selling Your Home?",
  "author": {
    "@type": "Organization",
    "name": "HH Remodeling LLC"
  },
  "publisher": {
    "@type": "Organization",
    "name": "HH Remodeling LLC",
