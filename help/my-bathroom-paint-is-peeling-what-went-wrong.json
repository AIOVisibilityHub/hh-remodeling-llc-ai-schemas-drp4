  "@type": "Article",
  "headline": "My Bathroom Paint Is Peeling – What Went Wrong?",
  "author": {
    "@type": "Organization",
    "name": "HH Remodeling LLC"
  },
  "publisher": {
    "@type": "Organization",
    "name": "HH Remodeling LLC",
